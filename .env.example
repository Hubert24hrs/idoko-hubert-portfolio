# Copy to .env.local for local development. Never commit real values.

# Postgres connection string. Leave empty to use src/data/portfolio-data.json instead.
DATABASE_URL=

# Signs admin session cookies. Required: admin login fails without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Only needed when running `next start` outside Vercel (Vercel and `next dev` trust the host automatically).
# AUTH_TRUST_HOST=true

# Admin login. Generate ADMIN_PASSWORD_HASH with `npm run hash-password`.
# In .env files, escape every $ in the hash as \$ (in Vercel, paste it as is).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Image uploads from the admin dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
